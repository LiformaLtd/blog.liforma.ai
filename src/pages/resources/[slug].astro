---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources', ({ data }) => !data.draft);
  return resources.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'resources'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout kind="Resource" pathname={`/resources/${post.id}`} data={post.data}>
  <Content />
</ArticleLayout>
