---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const resources = await getCollection('resources', ({ data }) => !data.draft);
const searchItems = [
  ...posts.map((post) => ({ href: `/blog/${post.id}`, title: post.data.title, description: post.data.description })),
  ...resources.map((post) => ({ href: `/resources/${post.id}`, title: post.data.title, description: post.data.description }))
];
---

<BaseLayout title="Search" description="Search Liforma blog and resource articles." pathname="/blog/search">
  <section class="listing narrow">
    <div class="listing-heading"><h1>Search</h1><p>Search the Liforma blog and resources.</p></div>
    <label class="search-label" for="content-search">Search articles</label>
    <input id="content-search" class="search-input" type="search" autocomplete="off" placeholder="Avatar pricing, WebRTC, Tavus…" />
    <div id="search-results" class="search-results" aria-live="polite"></div>
  </section>
  <script define:vars={{ searchItems }}>
    const input = document.querySelector('#content-search');
    const results = document.querySelector('#search-results');
    const render = () => {
      if (!(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return;
      const query = input.value.trim().toLowerCase();
      const matches = query.length < 2
        ? []
        : searchItems.filter((item) => `${item.title} ${item.description}`.toLowerCase().includes(query)).slice(0, 30);
      results.innerHTML = matches.length
        ? matches.map((item) => `<a class="search-result" href="${item.href}"><strong>${item.title}</strong><span>${item.description}</span></a>`).join('')
        : query.length >= 2 ? '<p>No matching articles.</p>' : '';
    };
    input?.addEventListener('input', render);
  </script>
</BaseLayout>
