---
import HeroPicture from './HeroPicture.astro';
import { formatDate, tagLabel } from '../lib/site';

interface Props {
  href: string;
  title: string;
  description: string;
  datePublished: Date;
  imageKey: string;
  imageAlt: string;
  tags?: string[];
  purpose?: string;
  eager?: boolean;
}

const { href, title, description, datePublished, imageKey, imageAlt, tags = [], purpose, eager = false } = Astro.props;
---

<a class="content-card" href={href}>
  <div class="content-card-cover">
    <HeroPicture
      imageKey={imageKey}
      alt={imageAlt}
      width={480}
      widths={[480, 720, 960]}
      sizes="(max-width: 44rem) calc(100vw - 2.5rem), (max-width: 65rem) calc((100vw - 3.75rem) / 2), calc((min(100vw, 72rem) - 5rem) / 3)"
      fallbackWidth={480}
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="content-card-body">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="content-card-meta">
      <span class="pill">{formatDate(datePublished)}</span>
      {purpose && <span class="pill">{purpose}</span>}
      {tags.map((tag) => <span class="pill">{tagLabel(tag)}</span>)}
    </div>
  </div>
</a>
